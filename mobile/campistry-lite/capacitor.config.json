{
  "appId": "com.campistry.lite",
  "appName": "Campistry Lite",
  "webDir": "www",
  "backgroundColor": "#F7F2EF",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#F7F2EF",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#F7F2EF"
    }
  }
}
