# Files that never need to reach the browser — excluding them shrinks every
# Vercel deployment (was ~56MB/deploy; most of that was dev-only content that
# is never served). Smaller deployments = far less accumulated deployment
# storage and faster builds.

# Dev dependencies — the site vendors its runtime libs as committed root
# files (xlsx@*.js, pdf-lib@*.js, pdfjs-dist@*.js, jsqr@*.js), so node_modules
# is dev-only and must never be uploaded (~19MB every deploy).
node_modules

# Native mobile app source (Swift/Gradle/Xcode) — not part of the web app.
mobile

# Server-side / build-time only — never served as static assets by Vercel.
# NOTE: scripts/ is deliberately NOT excluded — vercel.json's ignoreCommand
# runs scripts/vercel-ignore-build.sh, so it must stay available at build time.
# NOTE: ota/ is deliberately NOT excluded — api/ota.js require()s
# ota/link.json and ota/lite.json AT RUNTIME to tell each app the newest
# bundle. Excluding it made /api/ota crash (the manifests weren't in the
# function bundle), so no phone could ever discover an OTA update. The dir is
# only two tiny JSON manifests + the RELEASE stamp, so it costs nothing to keep.
supabase
migrations
tests
models

# Docs and planning notes.
docs
*.md
